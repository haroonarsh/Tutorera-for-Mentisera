{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tutorera-frontend",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "routes": [
    {
      "pattern": "tutorera.ac.pk/*",
      "zone_name": "tutorera.ac.pk"
    },
    {
      "pattern": "www.tutorera.ac.pk/*",
      "zone_name": "tutorera.ac.pk"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://tutorera-backend.onrender.com/api/v1",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "896228082480-4rj6gcpgbtjihver9shi0u59umkh4bh8.apps.googleusercontent.com"
  }
}
