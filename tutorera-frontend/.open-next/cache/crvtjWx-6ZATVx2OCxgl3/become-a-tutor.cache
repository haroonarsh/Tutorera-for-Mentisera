dding:0.5rem 0.75rem;color:#1a1a2e;text-decoration:none;font-size:0.9rem;font-weight:500;border-radius:0.4rem\" href=\"/\">Home</a><a style=\"padding:0.5rem 0.75rem;color:#1a1a2e;text-decoration:none;font-size:0.9rem;font-weight:500;border-radius:0.4rem\" href=\"/tutors\">Find a Tutor</a><a style=\"padding:0.5rem 0.75rem;color:#1a1a2e;text-decoration:none;font-size:0.9rem;font-weight:500;border-radius:0.4rem\" href=\"/become-a-tutor\">Become a Tutor</a><div style=\"position:relative\"><button style=\"display:flex;align-items:center;gap:0.3rem;padding:0.5rem 0.75rem;color:#1a1a2e;background:none;border:none;cursor:pointer;font-size:0.9rem;font-weight:500;border-radius:0.4rem\">Subjects<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down\" aria-hidden=\"true\" style=\"transform:rotate(0);transition:transform 0.2s\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div style=\"position:relative\"><button style=\"display:flex;align-items:center;gap:0.3rem;padding:0.5rem 0.75rem;color:#1a1a2e;background:none;border:none;cursor:pointer;font-size:0.9rem;font-weight:500;border-radius:0.4rem\">Levels<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down\" aria-hidden=\"true\" style=\"transform:rotate(0);transition:transform 0.2s\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div style=\"position:relative\"><button style=\"display:flex;align-items:center;gap:0.3rem;padding:0.5rem 0.75rem;color:#1a1a2e;background:none;border:none;cursor:pointer;font-size:0.9rem;font-weight:500;border-radius:0.4rem\">Coverage<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down\" aria-hidden=\"true\" style=\"transform:rotate(0);transition:transform 0.2s\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div></div><div style=\"display:flex;align-items:center;gap:0.5rem\" class=\"hidden-mobile\"><a style=\"padding:0.5rem 1rem;color:#1a1a2e;text-decoration:none;font-size:0.9rem;font-weight:500;border-radius:0.4rem\" href=\"/login\">Log in</a><a style=\"padding:0.5rem 1.25rem;background-color:#2563eb;color:white;text-decoration:none;font-size:0.9rem;font-weight:600;border-radius:0.5rem\" href=\"/register\">Sign Up</a></div><button style=\"background:none;border:none;cursor:pointer;color:#1a1a2e;display:none\" class=\"show-mobile\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div><style>\n        @media (max-width: 768px) { .hidden-mobile { display: none !important; } .show-mobile { display: block !important; } }\n        @media (min-width: 769px) { .show-mobile { display: none !important; } }\n      </style></nav><main><div style=\"background-color:white;min-height:100vh\"><section style=\"background-color:#1a1a2e;padding:5rem 1.5rem;text-align:center\"><div style=\"max-width:800px;margin:0 auto\"><div style=\"display:inline-flex;align-items:center;gap:0.5rem;background-color:rgba(37,99,235,0.2);color:#93c5fd;padding:0.4rem 1rem;border-radius:999px;font-size:0.85rem;font-weight:600;margin-bottom:1.5rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg> Join 500+ Verified Tutors</div><h1 style=\"font-size:clamp(2rem, 5vw, 3.2rem);font-weight:800;color:white;line-height:1.2;margin-bottom:1.25rem\">Teach Smarter with<br/><span style=\"color:#60a5fa\">TUTORERA®</span></h1><p style=\"color:#9ca3af;font-size:1.05rem;max-width:560px;margin:0 auto 2.5rem;line-height:1.75\">Reach serious students across Pakistan. Build your tutoring career on a structured, professional platform — without chasing leads.</p><div style=\"display:flex;gap:1rem;justify-content:center;flex-wrap:wrap\"><a style=\"background-color:#2563eb;color:white;padding:0.9rem 2rem;border-radius:0.5rem;font-weight:700;font-size:1rem;text-decoration:none;display:inline-flex;align-items:center;gap:0.5rem\" href=\"/register?role=tutor\">Get Started Free <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a style=\"border:1.5px solid rgba(255,255,255,0.3);color:white;padding:0.9rem 2rem;border-radius:0.5rem;font-weight:600;font-size:1rem;text-decoration:none\" href=\"/tutors\">See Tutor Profiles</a></div></div></section><section style=\"padding:5rem 1.5rem;background-color:#f9fafb\"><div style=\"max-width:1100px;margin:0 auto\"><div style=\"text-align:center;margin-bottom:3rem\"><h2 style=\"font-size:2rem;font-weight:800;color:#1a1a2e;margin-bottom:0.5rem\">Why Teach on TUTORERA®?</h2><p style=\"color:#6b7280\">Everything you need to grow your tutoring career.</p></div><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:1.5rem\"><div style=\"background-color:white;border-radius:0.875rem;padding:1.75rem;border:1px solid #e5e7eb\"><div style=\"width:48px;height:48px;background-color:#eff6ff;border-radius:0.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 style=\"font-weight:700;color:#1a1a2e;font-size:1rem;margin-bottom:0.5rem\">Access Serious Students</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Connect with motivated students and parents who are actively searching for tutors — no cold outreach needed.</p></div><div style=\"background-color:white;border-radius:0.875rem;padding:1.75rem;border:1px solid #e5e7eb\"><div style=\"width:48px;height:48px;background-color:#eff6ff;border-radius:0.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg></div><h3 style=\"font-weight:700;color:#1a1a2e;font-size:1rem;margin-bottom:0.5rem\">Teach on Your Schedule</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Set your own availability. Teach part-time or full-time — you&#x27;re in complete control of your calendar.</p></div><div style=\"background-color:white;border-radius:0.875rem;padding:1.75rem;border:1px solid #e5e7eb\"><div style=\"width:48px;height:48px;background-color:#eff6ff;border-radius:0.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div><h3 style=\"font-weight:700;color:#1a1a2e;font-size:1rem;margin-bottom:0.5rem\">Verified &amp; Trusted Badge</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Get a verified badge after credential review. Stand out from unverified tutors and build trust with parents.</p></div><div style=\"background-color:white;border-radius:0.875rem;padding:1.75rem;border:1px solid #e5e7eb\"><div style=\"width:48px;height:48px;background-color:#eff6ff;border-radius:0.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star\" aria-hidden=\"true\"><path d=\"M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z\"></path></svg></div><h3 style=\"font-weight:700;color:#1a1a2e;font-size:1rem;margin-bottom:0.5rem\">Build Your Reputation</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Collect reviews from students after each session. A strong profile attracts more bookings automatically.</p></div><div style=\"background-color:white;border-radius:0.875rem;padding:1.75rem;border:1px solid #e5e7eb\"><div style=\"width:48px;height:48px;background-color:#eff6ff;border-radius:0.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg></div><h3 style=\"font-weight:700;color:#1a1a2e;font-size:1rem;margin-bottom:0.5rem\">Professional Platform</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">No WhatsApp groups or informal arrangements. A clean, professional system handles everything for you.</p></div><div style=\"background-color:white;border-radius:0.875rem;padding:1.75rem;border:1px solid #e5e7eb\"><div style=\"width:48px;height:48px;background-color:#eff6ff;border-radius:0.75rem;display:flex;align-items:center;justify-content:center;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div><h3 style=\"font-weight:700;color:#1a1a2e;font-size:1rem;margin-bottom:0.5rem\">Grow Your Income</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Set your own hourly rate. Top tutors on TUTORERA® earn Rs. 5,000–15,000 per day from multiple students.</p></div></div></div></section><section style=\"padding:5rem 1.5rem;background-color:white\"><div style=\"max-width:900px;margin:0 auto;text-align:center\"><h2 style=\"font-size:2rem;font-weight:800;color:#1a1a2e;margin-bottom:0.5rem\">How It Works</h2><p style=\"color:#6b7280;margin-bottom:3.5rem\">Get started in 3 simple steps.</p><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:2rem\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:0.75rem\"><div style=\"width:64px;height:64px;background-color:#1a1a2e;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:800\">1</div><h3 style=\"font-size:1.1rem;font-weight:700;color:#1a1a2e\">Create Your Profile</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.6\">Sign up and fill in your subjects, levels, hourly rate, bio, and availability.</p></div><div style=\"display:flex;flex-direction:column;align-items:center;gap:0.75rem\"><div style=\"width:64px;height:64px;background-color:#1a1a2e;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:800\">2</div><h3 style=\"font-size:1.1rem;font-weight:700;color:#1a1a2e\">Get Verified</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.6\">Submit your CNIC and degree. Our team reviews and approves within 24 hours.</p></div><div style=\"display:flex;flex-direction:column;align-items:center;gap:0.75rem\"><div style=\"width:64px;height:64px;background-color:#1a1a2e;color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:800\">3</div><h3 style=\"font-size:1.1rem;font-weight:700;color:#1a1a2e\">Start Teaching</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.6\">Receive booking requests, accept sessions, and start earning.</p></div></div></div></section><section style=\"padding:5rem 1.5rem;background-color:#f9fafb\"><div style=\"max-width:800px;margin:0 auto\"><div style=\"text-align:center;margin-bottom:3rem\"><h2 style=\"font-size:2rem;font-weight:800;color:#1a1a2e;margin-bottom:0.5rem\">Who Can Join?</h2><p style=\"color:#6b7280\">We welcome qualified educators across Pakistan.</p></div><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:1.5rem\"><div style=\"background-color:white;border-radius:0.875rem;padding:2rem;border:1px solid #e5e7eb\"><h3 style=\"font-weight:700;color:#1a1a2e;margin-bottom:1.25rem;font-size:1rem\">✅ Requirements</h3><ul style=\"list-style:none;padding:0;display:flex;flex-direction:column;gap:0.75rem\"><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#16a34a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> <!-- -->Bachelor&#x27;s degree or higher</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#16a34a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> <!-- -->Valid CNIC (Pakistani citizen)</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#16a34a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> <!-- -->Minimum 1 year teaching experience</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#16a34a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> <!-- -->Reliable internet connection</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#16a34a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg> <!-- -->Passion for teaching</li></ul></div><div style=\"background-color:white;border-radius:0.875rem;padding:2rem;border:1px solid #e5e7eb\"><h3 style=\"font-weight:700;color:#1a1a2e;margin-bottom:1.25rem;font-size:1rem\">📚 Subjects We Need</h3><ul style=\"list-style:none;padding:0;display:flex;flex-direction:column;gap:0.75rem\"><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> <!-- -->Mathematics &amp; Statistics</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> <!-- -->Physics, Chemistry, Biology</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> <!-- -->English &amp; Urdu Language</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> <!-- -->Computer Science &amp; IT</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> <!-- -->Economics &amp; Accounts</li><li style=\"display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\" style=\"flex-shrink:0\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg> <!-- -->Entry Test Preparation</li></ul></div></div></div></section><section style=\"padding:5rem 1.5rem;background-color:white\"><div style=\"max-width:700px;margin:0 auto\"><h2 style=\"font-size:2rem;font-weight:800;color:#1a1a2e;text-align:center;margin-bottom:3rem\">Common Questions</h2><div style=\"display:flex;flex-direction:column;gap:1rem\"><div style=\"background-color:#f9fafb;border-radius:0.875rem;padding:1.5rem;border:1px solid #e5e7eb\"><h3 style=\"font-weight:700;color:#1a1a2e;font-size:0.95rem;margin-bottom:0.6rem\">Is it free to join as a tutor?</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Yes, creating a tutor profile on TUTORERA® is completely free. We only charge a small platform fee on successful bookings.</p></div><div style=\"background-color:#f9fafb;border-radius:0.875rem;padding:1.5rem;border:1px solid #e5e7eb\"><h3 style=\"font-weight:700;color:#1a1a2e;font-size:0.95rem;margin-bottom:0.6rem\">How long does verification take?</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Our team reviews tutor applications within 24–48 hours. You&#x27;ll receive an email notification once approved.</p></div><div style=\"background-color:#f9fafb;border-radius:0.875rem;padding:1.5rem;border:1px solid #e5e7eb\"><h3 style=\"font-weight:700;color:#1a1a2e;font-size:0.95rem;margin-bottom:0.6rem\">Can I set my own hourly rate?</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">Absolutely. You set your own price. We recommend Rs. 1,500–5,000/hour depending on your level and subject.</p></div><div style=\"background-color:#f9fafb;border-radius:0.875rem;padding:1.5rem;border:1px solid #e5e7eb\"><h3 style=\"font-weight:700;color:#1a1a2e;font-size:0.95rem;margin-bottom:0.6rem\">Do I need to be in a specific city?</h3><p style=\"color:#6b7280;font-size:0.875rem;line-height:1.65\">No. TUTORERA® supports online tutoring across all of Pakistan. You can also offer in-person sessions in your city.</p></div></div></div></section><section style=\"padding:5rem 1.5rem;background-color:#1a1a2e;text-align:center\"><div style=\"max-width:600px;margin:0 auto\"><h2 style=\"font-size:2rem;font-weight:800;color:white;margin-bottom:1rem\">Ready to Start Teaching?</h2><p style=\"color:#9ca3af;margin-bottom:2.5rem;font-size:1rem\">Join Pakistan&#x27;s fastest growing tutoring platform today.</p><a style=\"display:inline-flex;align-items:center;gap:0.5rem;background-color:#2563eb;color:white;padding:1rem 2.5rem;border-radius:0.5rem;font-weight:700;font-size:1.05rem;text-decoration:none\" href=\"/register?role=tutor\">Create Tutor Account <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></section></div><!--$--><!--/$--></main><footer style=\"background-color:#1a1a2e;color:white;padding-top:4rem;padding-bottom:2rem\"><div style=\"max-width:1280px;margin:0 auto;padding:0 1.5rem\"><div style=\"display:grid;grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));gap:2.5rem;margin-bottom:3rem\"><div style=\"grid-column:span 1\"><div style=\"display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open\" aria-hidden=\"true\"><path d=\"